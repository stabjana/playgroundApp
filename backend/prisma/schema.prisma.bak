generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model user_profiles {
  id         String    @id @db.Uuid
  username   String?
  avatar_url String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  email      String?

  favourites          favourites[]
  images              images[]
  playground_features playground_features[]
  reviews             reviews[]

  @@schema("public")
}

model favourites {
  id              String    @id @default(uuid()) @db.Uuid
  playground_id   String    @db.Uuid
  user_profile_id String    @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  playgrounds   playgrounds   @relation(fields: [playground_id], references: [id])
  user_profiles user_profiles @relation(fields: [user_profile_id], references: [id])

  @@schema("public")
}

model features {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String                @unique
  icon                String?
  description         String?
  playground_features playground_features[]

  @@schema("public")
}

model images {
  id              String    @id @default(uuid()) @db.Uuid
  playground_id   String    @db.Uuid
  user_profile_id String?   @db.Uuid
  image_url       String
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  playgrounds   playgrounds    @relation(fields: [playground_id], references: [id])
  user_profiles user_profiles? @relation(fields: [user_profile_id], references: [id])

  @@schema("public")
}

model playground_addresses {
  id            String                   @id @default(uuid()) @db.Uuid
  playground_id String                   @db.Uuid
  street        String?
  city          String?
  postal_code   String?
  latitude      Float?
  longitude     Float?
  geom          Unsupported("geometry")?
  created_at    DateTime?                @default(now()) @db.Timestamptz(6)

  playgrounds playgrounds @relation(fields: [playground_id], references: [id])

  @@schema("public")
}

model playground_features {
  id              String    @id @default(uuid()) @db.Uuid
  playground_id   String?   @db.Uuid
  feature_id      String?   @db.Uuid
  user_profile_id String?   @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  user_profiles user_profiles? @relation(fields: [user_profile_id], references: [id])
  features      features?      @relation(fields: [feature_id], references: [id])
  playgrounds   playgrounds?   @relation(fields: [playground_id], references: [id])

  @@schema("public")
}

model playgrounds {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  manufacturer_age_min Int?
  manufacturer_age_max Int?
  avg_rating           Decimal?  @default(0) @db.Decimal
  created_by           String?   @db.Uuid
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  favourites           favourites[]
  images               images[]
  playground_addresses playground_addresses[]
  playground_features  playground_features[]
  reviews              reviews[]

  @@schema("public")
}

model reviews {
  id              String    @id @default(uuid()) @db.Uuid
  playground_id   String    @db.Uuid
  user_profile_id String    @db.Uuid
  rating          Int?
  comment         String?
  age_min         Int?
  age_max         Int?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  playgrounds   playgrounds   @relation(fields: [playground_id], references: [id])
  user_profiles user_profiles @relation(fields: [user_profile_id], references: [id])

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)

  @@schema("public")
}
